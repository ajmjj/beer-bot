  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@whiskeysockets/baileys": "^6.7.0",
    "dotenv": "^16.4.0",
    "pino": "^9.0.0",
    "qrcode-terminal": "^0.12.0"
