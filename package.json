{
  "name": "beer-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Live WhatsApp beer tracking for the OMB group (Baileys -> Supabase)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bot": "node src/bot.js",
    "bot:log": "node src/bot.js 2>&1 | node scripts/pretty-log.js >> beer-bot.log",
    "backfill": "node scripts/backfill.js",
    "gaps": "node scripts/gaps.js",
    "match-gaps": "node scripts/match-gaps.js",
